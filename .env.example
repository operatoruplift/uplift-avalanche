# Operator Uplift commitment escrow. Copy to .env and fill in locally.
# Never commit .env. Never put a real key in this example file.
#
# These scripts do not create a key. Generate or fund one yourself, then export
# it in the shell before forge script. Leave the deployer key unset to broadcast
# with `forge script --unlocked --sender <address>` against local Anvil.
#
# BSC_* is the BNB Smart Chain testnet (chain id 97) pair of the FUJI_* names.
# The website reads NEXT_PUBLIC_BSC_ESCROW_ADDRESS, NEXT_PUBLIC_BSC_USDC_ADDRESS,
# and the other BSC_* names the same way it reads the FUJI_* names.

# ---------------------------------------------------------------------------
# BNB Smart Chain testnet (chain id 97). Primary network for this submission.
# ---------------------------------------------------------------------------

# Public BSC testnet RPC. Same URL as foundry.toml rpc_endpoints.bsc-testnet.
# Fallback if publicnode is down: https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Some networks fail TLS to that dataseed host.
BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Hex private key of the funded deployer. Read by script/Deploy.s.sol only when
# this variable is non-empty. Keep it in the shell environment, never in git.
# The script sets the escrow admin to the address of this key.
BSC_DEPLOYER_PRIVATE_KEY=

# Address of BSC_DEPLOYER_PRIVATE_KEY. The deploy command passes it as --sender.
BSC_DEPLOYER_ADDRESS=

# Address that receives the 4 percent protocol share. Not a key.
BSC_TREASURY_ADDRESS=

# Address granted VERIFIER_ROLE. The off-chain verifier sends recordProof as
# this address. Keep that key out of git and out of the browser.
BSC_VERIFIER_ADDRESS=

# Filled in after a broadcast. Used by the verify commands.
# BSC_ADMIN_ADDRESS is optional at deploy time: when the deployer key is unset,
# the script uses it as the escrow admin. When the key is set, admin is the
# key's address, and this value must match that address if it is set.
BSC_USDC_ADDRESS=
BSC_ESCROW_ADDRESS=
BSC_ADMIN_ADDRESS=

# Etherscan API v2 key. BscScan testnet verification uses this key with chain
# id 97. Etherscan lists chain 97 as paid tier. Leave empty to verify with
# Sourcify instead (see README).
BSCSCAN_API_KEY=

# Browser / server names the website reads. Set these on the host after deploy.
# Do not put BSC_VERIFIER_PRIVATE_KEY in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_BSC_CHAIN_ID=97
# NEXT_PUBLIC_BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# NEXT_PUBLIC_BSC_ESCROW_ADDRESS=
# NEXT_PUBLIC_BSC_USDC_ADDRESS=
# BSC_VERIFIER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Avalanche Fuji testnet (chain id 43113). Earlier deployment. Already live.
# ---------------------------------------------------------------------------

# Public Fuji C-Chain RPC. Chain id 43113.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Hex private key of the funded deployer. Read by script/Deploy.s.sol only when
# this variable is non-empty. Keep it in the shell environment, never in git.
FUJI_DEPLOYER_PRIVATE_KEY=

# Address that receives the 4 percent protocol share. Not a key.
FUJI_TREASURY_ADDRESS=

# Address granted VERIFIER_ROLE. The off-chain verifier signs recordProof as
# this address. Keep that key out of git and out of the browser.
FUJI_VERIFIER_ADDRESS=

# Routescan / Snowtrace verify API key. Any non-empty placeholder works for
# the public Routescan Fuji endpoint; use a real key if Snowtrace requires one.
SNOWTRACE_API_KEY=
