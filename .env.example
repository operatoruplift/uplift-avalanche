# Avalanche Fuji testnet. Copy to .env and fill in locally.
# Never commit .env. Never put a real key in this example file.
#
# This script does not create a key. Generate or fund one yourself, then export
# it in the shell before forge script. Leave the deployer key unset to broadcast
# with `forge script --unlocked --sender <address>` against local Anvil.

# Public Fuji C-Chain RPC. Chain id 43113.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Hex private key of the funded deployer. Read by script/Deploy.s.sol only when
# this variable is non-empty. Keep it in the shell environment, never in git.
FUJI_DEPLOYER_PRIVATE_KEY=

# Address that receives the 4 percent protocol share. Not a key.
FUJI_TREASURY_ADDRESS=

# Address granted VERIFIER_ROLE. The off-chain verifier signs recordProof as
# this address. Keep that key out of git and out of the browser.
FUJI_VERIFIER_ADDRESS=

# Routescan / Snowtrace verify API key. Any non-empty placeholder works for
# the public Routescan Fuji endpoint; use a real key if Snowtrace requires one.
SNOWTRACE_API_KEY=
